---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { formatPrix, site, withBase } from '../../site';

export const getStaticPaths = (async () => {
	const formations = await getCollection('formations');
	return formations.map((formation) => ({ params: { id: formation.id }, props: { formation } }));
}) satisfies GetStaticPaths;

interface Props {
	formation: CollectionEntry<'formations'>;
}

const { data } = Astro.props.formation;
---

<Base title={data.titre} description={`${data.accroche} Une formation de ${site.name}.`}>
	<article>
		<header class="fhero">
			<div class="container fhero__inner">
				<div>
					<a class="back" href={withBase('/#formations')}>← Toutes les formations</a>
					<p class="eyebrow">{data.format}</p>
					<h1>{data.titre}</h1>
					<p class="fhero__lead">{data.accroche}</p>
				</div>

				<aside class="achat" aria-label="Acheter cette formation">
					<p class="achat__prix">{formatPrix(data.prix)}</p>
					<p class="achat__duree">{data.duree} · {data.format}</p>
					<ul>
						{
							data.inclus.map((item) => (
								<li>
									<Icon name="check" /> {item}
								</li>
							))
						}
					</ul>
					{
						data.checkoutUrl ? (
							<a class="btn btn--primary" href={data.checkoutUrl}>
								Je m'inscris <Icon name="arrow" />
							</a>
						) : (
							<span class="btn btn--primary" aria-disabled="true">
								Inscriptions bientôt ouvertes
							</span>
						)
					}
					<p class="achat__secure">
						<Icon name="lock" /> Paiement sécurisé · Accès envoyé par e-mail
					</p>
					{
						!data.checkoutUrl && (
							<p class="achat__alt">
								Pour être prévenu·e de l'ouverture&nbsp;:{' '}
								<a href={`mailto:${site.email}?subject=${encodeURIComponent(data.titre)}`}>écrivez-moi</a>
							</p>
						)
					}
				</aside>
			</div>
		</header>

		<section class="section">
			<div class="container fdetail">
				<div>
					<h2>Pour qui&nbsp;?</h2>
					<ul class="pourqui">
						{
							data.pourQui.map((p) => (
								<li>
									<span class="icon-badge">
										<Icon name="target" />
									</span>
									{p}
								</li>
							))
						}
					</ul>
				</div>

				<div>
					<h2>Le programme</h2>
					<ol class="programme">
						{
							data.programme.map((m) => (
								<li>
									<h3>{m.titre}</h3>
									<p>{m.description}</p>
								</li>
							))
						}
					</ol>
				</div>
			</div>
		</section>
	</article>
</Base>

<style>
	.fhero {
		padding-block: clamp(40px, 6vw, 80px);
		background: var(--paper-deep);
	}

	.fhero__inner {
		display: grid;
		grid-template-columns: 1.3fr 0.7fr;
		gap: clamp(40px, 6vw, 80px);
		align-items: start;
	}

	.back {
		display: inline-block;
		margin-bottom: 32px;
		font-weight: 600;
		text-decoration: none;
		color: var(--ink-muted);
	}

	.back:hover {
		color: var(--brown);
	}

	.fhero__lead {
		margin-top: 24px;
		max-width: 36rem;
		font-size: var(--step-1);
		color: var(--ink-soft);
	}

	.achat {
		position: sticky;
		top: 100px;
		display: grid;
		gap: 16px;
		padding: clamp(28px, 3.5vw, 36px);
		border-radius: var(--radius-l);
		background: var(--card);
		box-shadow: var(--shadow);
	}

	.achat__prix {
		font-family: var(--font-serif);
		font-size: var(--step-4);
		line-height: 1;
	}

	.achat__duree {
		color: var(--ink-muted);
		font-size: 0.92rem;
	}

	.achat ul {
		display: grid;
		gap: 10px;
		margin: 8px 0;
		padding: 16px 0 0;
		border-top: 1px solid var(--line);
		list-style: none;
		font-size: 0.95rem;
	}

	.achat li {
		display: flex;
		gap: 10px;
		line-height: 1.45;
	}

	.achat li :global(svg),
	.achat__secure :global(svg) {
		flex: none;
		width: 18px;
		height: 18px;
		margin-top: 2px;
		color: var(--olive);
	}

	.achat__secure,
	.achat__alt {
		display: flex;
		gap: 8px;
		justify-content: center;
		font-size: 0.85rem;
		color: var(--ink-muted);
		text-align: center;
	}

	.achat__alt {
		display: block;
	}

	.fdetail {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: clamp(48px, 7vw, 96px);
		align-items: start;
	}

	.fdetail h2 {
		font-size: var(--step-3);
	}

	.pourqui {
		display: grid;
		gap: 20px;
		margin: 32px 0 0;
		padding: 0;
		list-style: none;
	}

	.pourqui li {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	.programme {
		margin: 32px 0 0;
		padding: 0;
		list-style: none;
		counter-reset: module;
	}

	.programme li {
		position: relative;
		padding: 0 0 28px 56px;
		counter-increment: module;
	}

	.programme li::before {
		content: counter(module, decimal-leading-zero);
		position: absolute;
		left: 0;
		top: 0;
		font-family: var(--font-serif);
		font-size: 1.4rem;
		line-height: 1.2;
		color: var(--brown);
	}

	.programme li:not(:last-child)::after {
		content: '';
		position: absolute;
		left: 14px;
		top: 40px;
		bottom: 8px;
		width: 1.5px;
		background: var(--line);
	}

	.programme h3 {
		font-size: var(--step-1);
	}

	.programme p {
		margin-top: 6px;
		color: var(--ink-soft);
	}

	@media (max-width: 860px) {
		.fhero__inner,
		.fdetail {
			grid-template-columns: 1fr;
		}

		.achat {
			position: static;
		}
	}
</style>
