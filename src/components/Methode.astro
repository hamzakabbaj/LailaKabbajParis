---
import Icon from './Icon.astro';

const piliers = [
	{
		icon: 'eye',
		titre: 'Lecture rapide',
		texte: "Guider son regard, lire par groupes de mots, limiter les retours en arrière inutiles et adapter sa vitesse à ce que l'on cherche.",
	},
	{
		icon: 'brain',
		titre: 'Mémorisation',
		texte: "Lire avec une intention, ancrer les idées clés et les réviser au bon moment pour s'en souvenir durablement.",
	},
	{
		icon: 'mindmap',
		titre: 'Mind mapping',
		texte: "Résumer un chapitre ou un livre entier sur une seule page, avec une carte qui suit la façon dont on pense.",
	},
] as const;

const benefices = [
	{ icon: 'rocket', texte: 'Lire plus vite, sans perdre le sens' },
	{ icon: 'flag', texte: 'Finir davantage de livres' },
	{ icon: 'brain', texte: 'Retenir les idées essentielles' },
	{ icon: 'heart', texte: 'Retrouver le plaisir de lire' },
] as const;

const etapes = [
	{ titre: 'Mesurer', texte: 'Votre vitesse et votre compréhension de départ.' },
	{ titre: 'Comprendre', texte: 'Les habitudes qui vous ralentissent.' },
	{ titre: "S'entraîner", texte: 'Quelques minutes par jour, avec vos propres livres.' },
	{ titre: 'Ancrer', texte: 'Jusqu’à ce que la méthode devienne naturelle.' },
];
---

<section class="section section--deep" id="methode">
	<div class="container">
		<header class="section-head section-head--center">
			<p class="eyebrow">La méthode</p>
			<h2>Trois piliers pour lire <span class="accent">autrement</span></h2>
			<p>
				Lire vite ne sert à rien si l'on oublie tout. La méthode travaille ensemble la vitesse, la
				compréhension et la mémoire.
			</p>
		</header>

		<div class="piliers">
			{
				piliers.map((p, i) => (
					<article class="pilier">
						<span class="pilier__num">0{i + 1}</span>
						<span class="icon-badge icon-badge--olive">
							<Icon name={p.icon} />
						</span>
						<h3>{p.titre}</h3>
						<p>{p.texte}</p>
					</article>
				))
			}
		</div>

		<div class="benefices">
			<h3 class="benefices__title">Les bénéfices</h3>
			<ul>
				{
					benefices.map((b) => (
						<li>
							<span class="icon-badge icon-badge--olive">
								<Icon name={b.icon} />
							</span>
							{b.texte}
						</li>
					))
				}
			</ul>
		</div>

		<ol class="etapes" aria-label="Comment se déroule l'apprentissage">
			{
				etapes.map((e) => (
					<li>
						<strong>{e.titre}</strong>
						<span>{e.texte}</span>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.piliers {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.pilier {
		position: relative;
		padding: clamp(28px, 3.5vw, 40px);
		border-radius: var(--radius-l);
		background: var(--card);
	}

	.pilier__num {
		position: absolute;
		top: 24px;
		right: 28px;
		font-family: var(--font-serif);
		font-size: 2.6rem;
		line-height: 1;
		color: var(--sand);
	}

	.pilier h3 {
		margin-top: 24px;
	}

	.pilier p {
		margin-top: 12px;
		color: var(--ink-soft);
	}

	.benefices {
		display: grid;
		gap: 28px;
		margin-top: 24px;
		padding: clamp(28px, 3.5vw, 40px);
		border-radius: var(--radius-l);
		border: 1.5px solid var(--line);
	}

	.benefices__title {
		font-size: var(--step-3);
	}

	.benefices ul {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.benefices li {
		display: flex;
		align-items: center;
		gap: 14px;
		font-weight: 600;
		line-height: 1.35;
	}

	.benefices .icon-badge {
		width: 48px;
		height: 48px;
	}

	.benefices .icon-badge :global(svg) {
		width: 22px;
		height: 22px;
	}

	.etapes {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
		margin: 64px 0 0;
		padding: 0;
		list-style: none;
		counter-reset: etape;
	}

	.etapes li {
		position: relative;
		display: grid;
		gap: 6px;
		padding-top: 28px;
		border-top: 1.5px solid var(--line);
		counter-increment: etape;
	}

	.etapes li::before {
		content: counter(etape);
		position: absolute;
		top: -14px;
		left: 0;
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--brown);
		color: #fff;
		font-size: 0.85rem;
		font-weight: 700;
	}

	.etapes strong {
		font-family: var(--font-serif);
		font-size: var(--step-2);
		font-weight: 500;
	}

	.etapes span {
		color: var(--ink-soft);
	}

	@media (max-width: 980px) {
		.benefices ul {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 820px) {
		.piliers {
			grid-template-columns: 1fr;
		}

		.etapes {
			grid-template-columns: repeat(2, 1fr);
			row-gap: 48px;
		}
	}

	@media (max-width: 480px) {
		.benefices ul,
		.etapes {
			grid-template-columns: 1fr;
		}
	}
</style>
