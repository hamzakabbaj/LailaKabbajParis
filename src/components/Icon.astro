	heart: '<path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/>',
	rocket:
		'<path d="M14.5 4.5c2.5-1 5-1 5-1s0 2.5-1 5L12 15l-3-3z"/><path d="M9 12l-3.5-.5L8 8.5h4M12 15l.5 3.5L15.5 16v-4"/><path d="M6.5 17.5c-1 1-1.5 3-1.5 3s2-.5 3-1.5"/><circle cx="15.5" cy="8.5" r="1.3"/>',
	flag: '<path d="M5 21V4"/><path d="M5 4h12l-2 4 2 4H5"/>',
	brain:
