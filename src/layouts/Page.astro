---
// Pages de texte simples (légales, confirmation, 404).
import Base from './Base.astro';

interface Props {
	title: string;
	description?: string;
	eyebrow?: string;
	noindex?: boolean;
}

const { title, description, eyebrow, noindex } = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
	<section class="section">
		<div class="container prose">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h1>{title}</h1>
			<slot />
		</div>
	</section>
</Base>

<style>
	.prose {
		max-width: 46rem;
	}

	.prose h1 {
		font-size: var(--step-4);
		margin-bottom: 32px;
	}

	.prose :global(h2) {
		margin: 48px 0 12px;
		font-size: var(--step-2);
	}

	.prose :global(p),
	.prose :global(li) {
		color: var(--ink-soft);
	}

	.prose :global(p + p) {
		margin-top: 14px;
	}

	.prose :global(.todo) {
		padding: 14px 18px;
		border-radius: var(--radius-s);
		border: 1.5px dashed var(--brown);
		background: var(--card);
		font-size: 0.92rem;
	}

	.prose :global(.btn) {
		margin-top: 32px;
	}
</style>
